# ==============================================================================
# RAG Document Intelligence - Windows 11 Configuration
# ==============================================================================

# Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Sentence Transformer Embedding Model (Hugging Face)
# Default lightweight & high-speed model: all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# RAG Text Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval Settings (Top chunks to retrieve)
TOP_K=5

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000
